# Cloudflare Pages response headers.
#
# One rule block per path pattern: a second `/*` block does not merge with the
# first, it replaces it. Everything for `/*` therefore lives together here.
#
# X-Robots-Tag keeps the demo / staging deployment out of search results.
# Remove it on launch day together with site.demo = false (GO LIVE GATE).
#
# HSTS is added only once a real domain is attached: *.pages.dev is shared.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/images/*
  Cache-Control: public, max-age=604800

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
