---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import ContactButtons from '../components/ContactButtons.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="הפנייה התקבלה" description="תודה, הפנייה התקבלה ואסףיחזור אליכם בהקדם. לתקלה דחופה עדיף להתקשר ישירות בטלפון." noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-success text-white"><Icon name="check" size={34} /></span>
      <h1 class="mt-6 text-4xl">הפנייה התקבלה</h1>
      <p class="mt-4 text-lg text-ink-soft">
        אסףיחזור אליכם בהקדם, בשעות הפעילות. לתקלה דחופה אל תחכו לחזרה, התקשרו. {site.hours.emergency}.
      </p>
      <ContactButtons class="mt-8 justify-center" />
      <a href="/" class="mt-8 inline-block font-bold">חזרה לדף הבית</a>
    </div>
  </section>
</BaseLayout>
