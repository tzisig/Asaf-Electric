---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { areas } from '../../data/areas';
import { breadcrumbSchema } from '../../data/schema';
import PageHero from '../../components/PageHero.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

const trail = [
  { name: 'דף הבית', href: '/' },
  { name: 'אזורי שירות', href: '/areas' },
];
---

<BaseLayout
  title="אזורי שירות - חשמלאי ברמת גן, גבעתיים, בני ברק, תל אביב וקריית אונו"
  description={`חשמלאי מוסמך שיוצא מ${site.baseCity} לכל גוש דן: רמת גן, גבעתיים, בני ברק, תל אביב וקריית אונו. זמן הגעה משוער לתקלה דחופה: ${site.emergencyResponse}.`}
  schema={[breadcrumbSchema(trail)]}
>
  <PageHero
    title="אזורי שירות"
    lead={`העסק יושב ב${site.baseCity}, ומשם יוצאים לכל קריאה. בערים הסמוכות מגיעים מהר, גם לתקלה דחופה באמצע הלילה.`}
    label="גוש דן"
    code="A00"
    trail={trail}
  >
    <ContactButtons />
  </PageHero>

  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <!-- Schematic map: relative positions only, not to scale. -->
      <figure class="card p-6">
        <svg viewBox="0 0 400 360" role="img" aria-labelledby="map-title" class="w-full">
          <title id="map-title">מפה סכמטית של אזורי השירות סביב רמת גן</title>
          <rect x="0" y="0" width="400" height="360" rx="16" fill="#f5f7fa" />
          <path d="M40 40 Q20 180 60 330" fill="none" stroke="#9cc3ff" stroke-width="10" stroke-linecap="round" />
          <text x="44" y="190" fill="#1a56c4" font-size="12" transform="rotate(-80 44 190)">הים התיכון</text>
          <g fill="none" stroke="#ffc928" stroke-width="2" stroke-dasharray="4 4">
            <line x1="215" y1="175" x2="120" y2="170" />
            <line x1="215" y1="175" x2="175" y2="230" />
            <line x1="215" y1="175" x2="230" y2="95" />
            <line x1="215" y1="175" x2="305" y2="215" />
          </g>
          <g font-family="Heebo Variable, sans-serif" font-weight="700" font-size="14" text-anchor="middle">
            <circle cx="120" cy="170" r="9" fill="#1a56c4" /><text x="120" y="152" fill="#0f1d2e">תל אביב</text>
            <circle cx="175" cy="230" r="9" fill="#1a56c4" /><text x="175" y="258" fill="#0f1d2e">גבעתיים</text>
            <circle cx="230" cy="95" r="9" fill="#1a56c4" /><text x="230" y="77" fill="#0f1d2e">בני ברק</text>
            <circle cx="305" cy="215" r="9" fill="#1a56c4" /><text x="305" y="243" fill="#0f1d2e">קריית אונו</text>
            <circle cx="215" cy="175" r="16" fill="#0b1b2e" /><circle cx="215" cy="175" r="7" fill="#ffc928" />
            <text x="262" y="170" fill="#0b1b2e">רמת גן</text>
            <text x="262" y="186" fill="#3d4f66" font-size="11" font-weight="400">הבסיס</text>
          </g>
        </svg>
        <figcaption class="mt-3 text-sm text-ink-soft">מפה סכמטית, לא בקנה מידה.</figcaption>
      </figure>

      <ul class="space-y-4">
        {areas.map((a) => (
          <li>
            <a href={`/areas/${a.slug}`} class="group card flex items-start gap-4 p-5 text-ink no-underline hover:border-blue">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-volt-soft text-night"><Icon name="map-pin" size={22} /></span>
              <span class="flex-1">
                <span class="block text-xl font-extrabold">חשמלאי {a.inCity}</span>
                <span class="mt-1 block text-ink-soft">{a.summary}</span>
                {a.neighborhoods.length > 0 && <span class="mt-2 block text-sm text-ink-soft">{a.neighborhoods.slice(0, 4).join(' · ')}</span>}
              </span>
              <Icon name="arrow-left" size={20} class="mt-1 shrink-0 text-blue transition-transform group-hover:-translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="container-site mt-10 text-ink-soft">גרים מחוץ לאזורים האלה? התקשרו ונבדוק לפי סוג העבודה והמועד.</p>
  </section>

  <CtaBand />
</BaseLayout>
