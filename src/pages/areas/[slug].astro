---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { areas, type Area } from '../../data/areas';
import { serviceBySlug } from '../../data/services';
import { testimonials } from '../../data/content';
import { faqSchema, breadcrumbSchema } from '../../data/schema';
import PageHero from '../../components/PageHero.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import LicenseCard from '../../components/LicenseCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import Faq from '../../components/Faq.astro';
import LeadForm from '../../components/LeadForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}
const { area } = Astro.props;
const trail = [
  { name: 'דף הבית', href: '/' },
  { name: 'אזורי שירות', href: '/areas' },
  { name: area.city, href: `/areas/${area.slug}` },
];
const top = area.topServices.map(serviceBySlug).filter((s) => s !== undefined);
const localReview = testimonials.find((t) => t.city === area.city);
const otherAreas = areas.filter((a) => a.slug !== area.slug);
---

<BaseLayout title={area.title} description={area.description} schema={[breadcrumbSchema(trail), faqSchema(area.faqs)]}>
  <PageHero title={area.heading} lead={area.intro[0]} label={`אזור שירות: ${area.city}`} code="A01" trail={trail}>
    <ContactButtons whatsappText={`שלום אסף, אני ${area.inCity} ואשמח לעזרה`} />
    <Fragment slot="aside">
      <LicenseCard />
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <div class="prose-site text-lg">
          {area.intro.slice(1).map((p) => <p>{p}</p>)}
        </div>

        <h2 class="mt-12 text-3xl">מה מיוחד בעבודות חשמל {area.inCity}</h2>
        <div class="mt-6 space-y-5">
          {area.local.map((l, i) => (
            <article class="card reveal flex gap-4 p-6">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-night font-mono text-sm font-bold text-volt">{i + 1}</span>
              <div>
                <h3 class="text-xl">{l.title}</h3>
                <p class="mt-1.5 text-ink-soft">{l.text}</p>
              </div>
            </article>
          ))}
        </div>

        <h2 class="mt-14 text-3xl">השירותים המבוקשים {area.inCity}</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {top.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="card flex items-center gap-3 p-4 font-bold text-ink no-underline hover:border-blue">
                <Icon name={s.icon} size={22} class="text-blue" />
                {s.name}
              </a>
            </li>
          ))}
        </ul>

        <h2 class="mt-14 text-3xl">שאלות על חשמלאי {area.inCity}</h2>
        <div class="mt-6"><Faq items={area.faqs} /></div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start">
        <div class="card p-5">
          <h2 class="flex items-center gap-2 text-lg"><Icon name="clock" size={20} class="text-blue" />זמינות {area.inCity}</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {site.hours.regular.map((h) => <li>{h.days}: <span class="ltr">{h.time}</span></li>)}
            <li class="font-bold text-danger">{site.hours.emergency}</li>
          </ul>
          <p class="mt-3 text-sm text-ink-soft">זמן הגעה משוער לתקלה דחופה: {site.emergencyResponse}.</p>
        </div>
        {area.neighborhoods.length > 0 && (
          <div class="card p-5">
            <h2 class="text-lg">שכונות שאנחנו מגיעים אליהן</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {area.neighborhoods.map((n) => <li class="rounded-full bg-paper px-3 py-1 text-sm">{n}</li>)}
            </ul>
          </div>
        )}
        {localReview && <TestimonialCard item={localReview} />}
      </aside>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 class="text-3xl">השאירו פרטים</h2>
        <p class="mt-3 text-lg text-ink-soft">אסף יחזור אליכם. לתקלה דחופה עדיף להתקשר.</p>
        <h3 class="mt-10 text-lg">אזורים נוספים</h3>
        <ul class="mt-3 space-y-2">
          {otherAreas.map((a) => <li><a href={`/areas/${a.slug}`} class="font-semibold">חשמלאי {a.inCity}</a></li>)}
        </ul>
      </div>
      <LeadForm city={area.city} />
    </div>
  </section>

  <CtaBand title={`תקלת חשמל ${area.inCity}?`} />
</BaseLayout>
