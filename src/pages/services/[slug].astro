---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { services, type Service } from '../../data/services';
import { areas } from '../../data/areas';
import { faqSchema, breadcrumbSchema, serviceSchema } from '../../data/schema';
import PageHero from '../../components/PageHero.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import Picture from '../../components/Picture.astro';
import PriceList from '../../components/PriceList.astro';
import Faq from '../../components/Faq.astro';
import LeadForm from '../../components/LeadForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const index = services.findIndex((s) => s.slug === service.slug);
const code = `F${String(index + 1).padStart(2, '0')}`;
const href = `/services/${service.slug}`;
const trail = [
  { name: 'דף הבית', href: '/' },
  { name: 'שירותים', href: '/services' },
  { name: service.name, href },
];
const others = services.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={service.title}
  description={service.description}
  schema={[
    serviceSchema(service.name, service.description, href, areas.map((a) => a.city)),
    breadcrumbSchema(trail),
    faqSchema(service.faqs),
  ]}
>
  <PageHero title={service.heading} lead={service.intro[0]} label={service.name} code={code} trail={trail}>
    <ContactButtons whatsappText={`שלום אסף, אני פונה בנושא ${service.name}`} />
    <Fragment slot="aside">
      <div class="overflow-hidden rounded-3xl border border-white/10 shadow-lift">
        <Picture image={service.image} sizes="(min-width: 1024px) 480px, 100vw" priority class="aspect-[4/3] w-full object-cover" />
      </div>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <div class="prose-site text-lg">
          {service.intro.slice(1).map((p) => <p>{p}</p>)}
        </div>

        <h2 class="mt-12 text-3xl">מתי מתקשרים</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {service.signs.map((s) => (
            <li class="card flex items-start gap-3 p-4">
              <Icon name="zap" size={20} class="mt-0.5 shrink-0 text-volt-dark" />
              <span>{s}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-14 text-3xl">מה כוללת העבודה</h2>
        <ol class="relative mt-8 space-y-8 border-s-2 border-dashed border-line ps-8">
          {service.steps.map((s, i) => (
            <li class="relative">
              <span class="absolute -start-[3.1rem] top-0 grid size-9 place-items-center rounded-full bg-night font-mono text-sm font-bold text-volt">{i + 1}</span>
              <h3 class="text-xl">{s.title}</h3>
              <p class="mt-1.5 text-ink-soft">{s.text}</p>
            </li>
          ))}
        </ol>

        {service.note && (
          <aside class="mt-14 rounded-2xl border-s-4 border-volt bg-volt-soft p-6">
            <h2 class="flex items-center gap-2 text-xl"><Icon name="circle-alert" size={22} class="text-volt-dark" />{service.note.title}</h2>
            <p class="mt-2 text-ink">{service.note.text}</p>
          </aside>
        )}

        <h2 class="mt-14 text-3xl">שאלות נפוצות</h2>
        <div class="mt-6"><Faq items={service.faqs} /></div>

        {service.sources && (
          <div class="mt-8 text-sm text-ink-soft">
            <p class="font-bold">מקורות</p>
            <ul class="mt-1 list-disc ps-5">
              {service.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
            </ul>
          </div>
        )}
      </div>

      <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start">
        <div>
          <h2 class="mb-3 text-xl">מחירים</h2>
          <PriceList keys={service.priceKeys} />
        </div>
        <div class="card p-5">
          <h2 class="text-lg">אזורי שירות</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {areas.map((a) => <li><a href={`/areas/${a.slug}`} class="inline-block rounded-full border border-line px-3 py-1 text-sm text-ink no-underline hover:border-blue">{a.city}</a></li>)}
          </ul>
          <p class="mt-4 text-sm text-ink-soft">{site.hours.emergency}.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 class="text-3xl">רוצים הצעת מחיר?</h2>
        <p class="mt-3 text-lg text-ink-soft">השאירו פרטים ואסף יחזור אליכם. לתקלה דחופה עדיף להתקשר.</p>
        <h3 class="mt-10 text-lg">שירותים נוספים</h3>
        <ul class="mt-3 space-y-2">
          {others.map((s) => (
            <li><a href={`/services/${s.slug}`} class="inline-flex items-center gap-2 font-semibold"><Icon name={s.icon} size={18} />{s.name}</a></li>
          ))}
        </ul>
      </div>
      <LeadForm subject={service.name} />
    </div>
  </section>

  <CtaBand whatsappText={`שלום אסף, אני פונה בנושא ${service.name}`} />
</BaseLayout>
