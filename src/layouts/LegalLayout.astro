---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '../components/Seo.astro';
import { breadcrumbSchema } from '../data/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props extends SeoProps {
  heading: string;
  updated: string;
}

const { heading, updated, schema = [], ...seo } = Astro.props;
const trail = [
  { name: 'דף הבית', href: '/' },
  { name: heading, href: Astro.url.pathname.replace(/\.html$/, '') },
];
---

<BaseLayout {...seo} schema={[breadcrumbSchema(trail), ...schema]}>
  <header class="border-b border-line bg-surface">
    <div class="container-site py-10 md:py-14">
      <Breadcrumbs trail={trail} />
      <h1 class="mt-4 text-4xl">{heading}</h1>
      <p class="mt-3 text-sm text-ink-soft">עודכן: {updated}</p>
      <p class="mt-5 max-w-3xl rounded-xl border-s-4 border-volt bg-volt-soft p-4 text-sm">
        <strong>טיוטה לבדיקת עורך דין.</strong> הנוסח נכתב כבסיס עבודה, אינו ייעוץ משפטי, וצריך לעבור אישור והתאמה
        לפעילות בפועל לפני עלייה לאוויר.
      </p>
    </div>
  </header>

  <div class="container-site py-10 md:py-14">
    <div class="legal max-w-3xl"><slot /></div>
  </div>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.5rem;
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-top: 0.75rem;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.35rem;
  }
</style>
