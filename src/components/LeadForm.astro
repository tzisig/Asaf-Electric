---
import { services } from '../data/services';
import { areas } from '../data/areas';

/**
 * Minimal lead form: name, phone, what happened. Everything else is optional.
 * Phone and WhatsApp convert better for urgent jobs; this form is for people
 * who cannot talk right now or want a quote for planned work.
 */
interface Props {
  /** Pre-selects the subject, e.g. on a service page. */
  subject?: string;
  /** Pre-selects the city, e.g. on a city page. */
  city?: string;
  id?: string;
}

const { subject, city, id = 'main' } = Astro.props;
const subjects = ['תקלה דחופה', ...services.map((s) => s.name), 'אחר'];
const cities = [...areas.map((a) => a.city), 'אחר'];
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? null;
const field = 'mt-1.5 w-full rounded-xl border-2 border-line bg-surface px-3.5 py-3 text-ink focus:border-blue focus:outline-none';
---

<form class="card p-5 sm:p-7" data-contact-form novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for={`name-${id}`} class="block font-bold">שם <span class="text-danger" aria-hidden="true">*</span></label>
      <input id={`name-${id}`} name="name" type="text" autocomplete="name" required aria-describedby={`err-name-${id}`} class={field} />
      <p id={`err-name-${id}`} class="mt-1 text-sm text-danger" data-error-for="name" hidden></p>
    </div>

    <div>
      <label for={`phone-${id}`} class="block font-bold">טלפון <span class="text-danger" aria-hidden="true">*</span></label>
      <input id={`phone-${id}`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required dir="ltr" aria-describedby={`err-phone-${id}`} class={`${field} text-start`} />
      <p id={`err-phone-${id}`} class="mt-1 text-sm text-danger" data-error-for="phone" hidden></p>
    </div>

    <div>
      <label for={`subject-${id}`} class="block font-bold">במה מדובר?</label>
      <select id={`subject-${id}`} name="subject" class={field}>
        {subjects.map((s) => <option value={s} selected={s === subject}>{s}</option>)}
      </select>
    </div>

    <div>
      <label for={`city-${id}`} class="block font-bold">עיר</label>
      <select id={`city-${id}`} name="city" class={field}>
        <option value="" selected={!city}>בחרו עיר</option>
        {cities.map((c) => <option value={c} selected={c === city}>{c}</option>)}
      </select>
    </div>

    <div class="sm:col-span-2">
      <label for={`message-${id}`} class="block font-bold">מה קרה? <span class="font-normal text-ink-soft">(לא חובה)</span></label>
      <textarea id={`message-${id}`} name="message" rows="4" class={field} placeholder="למשל: מפסק הפחת קופץ כל פעם שמדליקים את הדוד"></textarea>
    </div>

    <div class="sm:col-span-2">
      <label class="flex items-start gap-3">
        <input id={`consent-${id}`} name="consent" type="checkbox" required aria-describedby={`err-consent-${id}`} class="mt-1 size-5 shrink-0 accent-blue" />
        <span class="text-sm">
          קראתי ואני מסכים/ה ל<a href="/privacy">מדיניות הפרטיות</a> ולשימוש בפרטים כדי לחזור אליי בנוגע לפנייה.
          <span class="text-danger" aria-hidden="true">*</span>
        </span>
      </label>
      <p id={`err-consent-${id}`} class="mt-1 text-sm text-danger" data-error-for="consent" hidden></p>
    </div>
  </div>

  <!-- Honeypot: hidden from people, tempting for bots. -->
  <div class="absolute -start-[9999px]" aria-hidden="true">
    <label for={`company-${id}`}>חברה</label>
    <input id={`company-${id}`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {turnstileSiteKey && (
    <>
      <div class="cf-turnstile mt-6" data-sitekey={turnstileSiteKey} data-language="he"></div>
      <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
    </>
  )}

  <button type="submit" class="btn btn-primary mt-6 w-full">שליחה, אסף יחזור אליכם</button>
  <p class="mt-3 text-center text-sm text-ink-soft">תקלה מסוכנת? אל תחכו לטופס. התקשרו.</p>
  <p class="mt-3 text-sm" data-form-status role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const showError = (field: string, message: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (!el) return;
      el.textContent = message;
      el.hidden = !message;
      form.querySelector<HTMLInputElement>(`[name="${field}"]`)?.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      let firstInvalid: string | null = null;

      const checks: [string, boolean, string][] = [
        ['name', String(data.get('name') ?? '').trim().length >= 2, 'נא למלא שם'],
        ['phone', /^[\d\-+() ]{9,15}$/.test(String(data.get('phone') ?? '').trim()), 'נא למלא מספר טלפון תקין'],
        ['consent', data.get('consent') === 'on', 'צריך לאשר את מדיניות הפרטיות'],
      ];

      for (const [field, ok, message] of checks) {
        showError(field, ok ? '' : message);
        if (!ok && !firstInvalid) firstInvalid = field;
      }

      if (firstInvalid) {
        form.querySelector<HTMLElement>(`[name="${firstInvalid}"]`)?.focus();
        status.textContent = 'לא נשלח: יש שדות שצריך לתקן.';
        status.className = 'mt-3 text-sm text-danger';
        return;
      }

      // First-touch source, stored by Analytics.astro on the landing page.
      try {
        const attribution = sessionStorage.getItem('ab:attribution');
        if (attribution) data.append('attribution', attribution);
      } catch {
        // Storage blocked: send the lead without a source rather than failing.
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.textContent = 'שולח...';
      status.className = 'mt-3 text-sm text-ink-soft';

      try {
        const res = await fetch('/api/contact', { method: 'POST', body: data });
        if (!res.ok) throw new Error(String(res.status));
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'generate_lead' });
        if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead');
        window.location.href = '/thank-you';
      } catch (err) {
        console.error('lead submit failed', err);
        button.disabled = false;
        status.textContent = 'השליחה נכשלה. אפשר לנסות שוב, או פשוט להתקשר או לשלוח וואטסאפ.';
        status.className = 'mt-3 text-sm text-danger';
      }
    });
  });
</script>
