---
import type { Faq } from '../data/services';

/** Accessible accordion on <details>. The page adds the FAQPage schema with faqSchema(). */
interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
  {items.map((item) => (
    <details class="group">
      <summary class="faq-summary flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-start font-bold hover:bg-paper">
        {item.q}
        <span aria-hidden="true" class="grid size-7 shrink-0 place-items-center rounded-full border border-line text-lg leading-none text-blue transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="px-5 pb-5 text-ink-soft">{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-summary::-webkit-details-marker {
    display: none;
  }
</style>
