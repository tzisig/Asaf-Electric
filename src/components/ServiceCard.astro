---
import type { Service } from '../data/services';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

/** Service card styled like a circuit breaker: numbered label, toggle that flips on hover. */
interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
const code = `F${String(index + 1).padStart(2, '0')}`;
---

<a href={`/services/${service.slug}`} class="group card reveal flex flex-col overflow-hidden text-ink no-underline transition-shadow hover:shadow-lift">
  <div class="relative aspect-[16/10] overflow-hidden bg-night">
    <Picture image={service.image} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="size-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-[1.03]" />
    <span class="absolute start-3 top-3 rounded-md bg-night/85 px-2 py-0.5 font-mono text-xs font-bold text-volt" dir="ltr">{code}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="flex items-center gap-2 text-xl">
        <Icon name={service.icon} size={22} class="text-blue" />
        {service.name}
      </h3>
      <!-- Breaker toggle: off by default, on when the card is hovered or focused. -->
      <span aria-hidden="true" class="relative mt-1 h-6 w-11 shrink-0 rounded-full bg-line transition-colors duration-200 group-hover:bg-volt group-focus-visible:bg-volt">
        <span class="absolute start-0.5 top-0.5 size-5 rounded-full bg-white shadow transition-transform duration-200 group-hover:-translate-x-5 group-focus-visible:-translate-x-5"></span>
      </span>
    </div>
    <p class="mt-2 text-ink-soft">{service.summary}</p>
    <span class="mt-auto inline-flex items-center gap-1 pt-4 font-bold text-blue">
      לפרטים ומחירים
      <Icon name="arrow-left" size={18} class="transition-transform group-hover:-translate-x-1" />
    </span>
  </div>
</a>
