---
import { site } from '../config/site';
import { areas } from '../data/areas';

export interface SeoProps {
  title: string;
  description: string;
  /** Set for utility pages (thank-you, 404). */
  noindex?: boolean;
  ogImage?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, ogImage = '/og-image.jpg', schema = [] } = Astro.props as SeoProps;

const fullTitle = title.includes(site.ownerName) ? title : `${title} | ${site.ownerName}`;
/**
 * `build.format: 'file'` makes the build-time pathname end in `.html`, while the
 * host serves and the sitemap lists the extensionless URL. Strip it so the
 * canonical, the sitemap and the internal links all name the same address.
 */
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath.replace(/\/$/, '') || '/', Astro.site ?? site.url).href;
const image = ogImage ? new URL(ogImage, Astro.site ?? site.url).href : undefined;
// The demo site must never be indexed, on any page.
const robots = noindex || site.demo ? 'noindex, nofollow' : null;

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: site.tagline,
  url: site.url,
  telephone: site.contact.phone,
  email: site.contact.email,
  image: new URL('/og-image.jpg', site.url).href,
  priceRange: '₪₪',
  founder: {
    '@type': 'Person',
    name: site.ownerName,
    jobTitle: site.license.grade,
    hasCredential: [site.license.grade, site.license.inspectorGrade]
      .filter(Boolean)
      .map((name) => ({ '@type': 'EducationalOccupationalCredential', credentialCategory: 'license', name })),
  },
  address: { '@type': 'PostalAddress', addressLocality: site.baseCity, addressCountry: 'IL' },
  areaServed: areas.map((a) => ({ '@type': 'City', name: a.city })),
  openingHours: site.hours.regular.map((h) => `${h.schemaDays} ${h.time}`),
  inLanguage: 'he',
};
const sameAs = [site.googleBusinessUrl, ...Object.values(site.social)].filter(Boolean);
if (sameAs.length) business.sameAs = sameAs;

const jsonLd = [business, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
