---
import { site, yearsOfExperience } from '../config/site';
import Icon from './Icon.astro';

/**
 * The central trust element: the license, shown like the physical card,
 * with a link to where anyone can verify it.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['relative overflow-hidden rounded-2xl border border-white/15 bg-night-2 p-5 text-white shadow-lift', className]}>
  <div class="absolute inset-x-0 top-0 h-1.5 bg-volt"></div>
  <figcaption class="flex items-center justify-between gap-3">
    <span class="flex items-center gap-2 text-sm font-bold text-volt">
      <Icon name="badge-check" size={20} />
      רישיון חשמלאי
    </span>
    <span class="rounded-md border border-white/20 px-2 py-0.5 font-mono text-[0.7rem] text-white/70" dir="ltr">IL · ELEC</span>
  </figcaption>
  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
    <div class="col-span-2">
      <dt class="text-white/60">בעל הרישיון</dt>
      <dd class="text-lg font-extrabold">{site.ownerName}</dd>
    </div>
    <div>
      <dt class="text-white/60">דרגה</dt>
      <dd class="font-bold">{site.license.grade}</dd>
    </div>
    <div>
      <dt class="text-white/60">מספר רישיון</dt>
      <dd class="ltr text-start font-mono text-lg font-bold text-volt">{site.license.number}</dd>
    </div>
    {site.license.inspectorGrade && (
      <>
        <div>
          <dt class="text-white/60">רישיון נוסף</dt>
          <dd class="font-bold">{site.license.inspectorGrade}</dd>
        </div>
        <div>
          <dt class="text-white/60">מספר</dt>
          <dd class="ltr text-start font-mono text-lg font-bold text-volt">{site.license.inspectorNumber}</dd>
        </div>
      </>
    )}
  </dl>
  <p class="mt-3 border-t border-white/10 pt-3 text-sm text-white/75">
    {yearsOfExperience()} שנות ניסיון. {site.license.scope}.
  </p>
  <a href={site.licenseRegistryUrl} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-volt">
    איך בודקים רישיון חשמלאי במשרד העבודה
    <Icon name="arrow-left" size={16} />
  </a>
</figure>
